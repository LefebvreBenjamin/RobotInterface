<Window x:Class="RobotInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotInterface"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Emission" Background="#FF333232" Grid.Row="1" Grid.Column="1">
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap" AcceptsReturn="True" KeyUp="textBoxEmission_KeyUp_1"/>
        </GroupBox>
        <GroupBox Header="Réception" Background="#FF333232" Grid.Row="1" Grid.Column="3">
            <TextBox x:Name="textBoxReception" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
        </GroupBox>
        <Button x:Name="buttonEnvoyer" Content="Envoyer" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Center" Click="buttonEnvoyer_Click"/>
        <Button x:Name="buttonClear" Content="Clear" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Click="buttonClear_Click" Grid.ColumnSpan="3" Margin="320,30,0,0" Grid.RowSpan="2"/>
        <Button x:Name="buttonTest" Content="Tester" Grid.Row="2" Grid.Column="3" Width="100" HorizontalAlignment="Center" Click="buttonTester_Click" Height="30" Grid.RowSpan="2" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
